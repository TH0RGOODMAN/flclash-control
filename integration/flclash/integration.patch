 import 'package:fl_clash/common/system.dart';
+import 'package:fl_clash/models/models.dart' show ProxyState;
 import 'package:proxy/proxy.dart';
 
 final proxy = system.isDesktop ? Proxy() : null;
+
+Future<void> _pendingSystemProxyUpdate = Future<void>.value();
+
+/// Shared queue for GUI listeners and the authenticated control bridge.
+Future<bool> applySystemProxyState(ProxyState state) {
+  final operation = _pendingSystemProxyUpdate.then((_) async {
+    final result = state.isStart && state.systemProxy
+        ? await proxy?.startProxy(state.port, state.bassDomain)
+        : await proxy?.stopProxy();
+    return result == true;
+  });
+  _pendingSystemProxyUpdate = operation.then<void>((_) {}, onError: (Object _) {});
+  return operation;
+}
